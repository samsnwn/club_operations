# Backend service configuration — copy to backend/.env and edit as needed.
# Every value below is a development-safe default. Never commit a real .env.
# The service loads .env from the directory it is started in (backend/).

DATABASE_URL=sqlite:///./blue_velvet.db

# Invoice-service facade. The token must match
# invoice-service/.env -> INVOICE_INTERNAL_TOKEN. Use a unique secret outside
# development; the invoice service rejects the known development default in
# production.
INVOICE_SERVICE_URL=http://localhost:8081
INVOICE_SERVICE_TOKEN=development-invoice-service-token

# Authentication
SESSION_TTL_HOURS=12
# Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Comma-separated browser origins allowed to send state-changing requests.
ALLOWED_ORIGINS=http://localhost:5173
# Failed sign-ins tolerated per window before further attempts get 429.
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_MAX_FAILURES_PER_ADDRESS=30

# Used only by `python -m app.cli create-user` / reset-password.
# Prefer the interactive prompt; do not keep a password here long-term.
# NEW_USER_PASSWORD=
