# Optional Compose settings for the dev stack (copy to infra/.env, gitignored).
# Without this file only https://localhost is served.

# Extra address Caddy serves over HTTPS so phones on the LAN can reach the PWA.
# Use this machine's LAN IP (example: PUBLIC_HOST=192.168.1.50). Avoid .local
# names: Android resolves them unreliably. Leave empty to serve localhost only.
# After changing it, run `docker compose -f infra/docker-compose.yml up -d` to
# recreate the proxy and frontend containers.
PUBLIC_HOST=
