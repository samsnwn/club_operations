# Invoice-service configuration — copy to invoice-service/.env as needed.
# Every value below is a development-safe default. Never commit a real .env.
# The INVOICE_ prefix is added automatically to every field name.

# "development" allows the known development token below. Any other value is
# treated as production: startup fails if the token is still the development
# default. Production must set INVOICE_ENVIRONMENT=production and a unique
# INVOICE_INTERNAL_TOKEN.
INVOICE_ENVIRONMENT=development

# Must match backend/.env -> INVOICE_SERVICE_TOKEN. Use a unique secret outside
# development; the service refuses to start with this default in production.
INVOICE_INTERNAL_TOKEN=development-invoice-service-token

INVOICE_DATABASE_URL=sqlite:///./data/invoices.db
INVOICE_ATTACHMENTS_DIR=./data/attachments
# Local inbox: development, tests and offline demos.
INVOICE_INBOX_DIR=./data/inbox

# Invoice folder (Google Drive). When both are set, Import reads the shared
# folder instead of the local inbox. The key file is the service account's JSON
# key; keep it under invoice-service/secrets/ (gitignored, mounted read-only in
# Docker as /app/secrets). See invoice-service/README.md "Google Drive setup".
# INVOICE_DRIVE_FOLDER_ID=
# INVOICE_DRIVE_CREDENTIALS_FILE=./secrets/drive-service-account.json
INVOICE_MAX_ATTACHMENT_BYTES=26214400
INVOICE_MAX_PDF_PAGES=100
INVOICE_MAX_EXTRACTED_TEXT_CHARS=1000000

# Keep false until the real accounting-sheet mapping is confirmed.
INVOICE_EXPORT_ENABLED=false

# Digest email (optional; the service logs instead when unset).
# INVOICE_SMTP_HOST=
# Verified TLS only: STARTTLS on 587, implicit TLS on 465; no plaintext.
# INVOICE_SMTP_PORT=587
# INVOICE_SMTP_USER=
# INVOICE_SMTP_PASSWORD=
# INVOICE_DIGEST_FROM=
# INVOICE_DIGEST_TO=
